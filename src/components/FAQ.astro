---
// src/components/FAQ.astro
const { title } = Astro.props;
---

<details class="custom-faq">
  <summary>
    {title}
    <span class="icon">+</span>
  </summary>
  <div class="faq-body">
    <slot />
  </div>
</details>

<style>
  /* This uses Starlight's built-in CSS variables for automatic Dark/Light mode support */
  .custom-faq {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    margin-bottom: 1rem;
    background-color: var(--sl-color-black);
    overflow: hidden;
  }
  
  .custom-faq summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none; 
  }
  
  /* Hides the default browser arrows */
  .custom-faq summary::-webkit-details-marker {
    display: none; 
  }
  
  .custom-faq summary:hover {
    background-color: var(--sl-color-gray-6);
  }
  
  /* Rotates the plus icon into an X when open */
  .custom-faq[open] .icon {
    transform: rotate(45deg);
  }
  
  .icon {
    font-size: 1.5rem;
    line-height: 1;
    transition: transform 0.2s ease;
  }
  
  .faq-body {
    padding: 1rem;
    border-top: 1px solid var(--sl-color-gray-5);
  }
</style>
